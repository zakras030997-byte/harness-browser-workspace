{
  "manifest_version": 3,
  "name": "Harness Use",
  "version": "0.3.1",
  "description": "Owned Chrome tabs, verified read recipes and bounded site memory for DeepSeek Harness.",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "🤖 Вкладки агента",
    "default_popup": "popup.html"
  },
  "key": "",
  "optional_permissions": [
    "cookies",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "https://www.youtube.com/*"
  ]
}
