{
  "manifest_version": 3,
  "name": "ANODHAS Browser Workspace",
  "version": "0.1.0",
  "description": "Background robot tabs and live previews for DeepSeek Harness. Explicit connection only.",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "🤖 Вкладки агента",
    "default_popup": "popup.html"
  },
  "key": ""
}
