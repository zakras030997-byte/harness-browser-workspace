{
  "name": "@anodhas/dsh-internal-browser",
  "version": "0.1.0",
  "description": "Control the actual built-in DeepSeek Harness Desktop browser panel",
  "license": "MIT",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "files": [
    "index.mjs",
    "client.js",
    "lib",
    "native",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "VALIDATION.md",
    "NOTICE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@electron/asar": "4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "pack": "npm pack --ignore-scripts"
  }
}
