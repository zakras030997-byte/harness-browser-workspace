{
  "name": "@anodhas/dsh-browser-workspace",
  "version": "0.4.0",
  "description": "Harness Use: shared DevTools Chrome core, learned public reads and background Computer Use",
  "license": "MIT",
  "author": "ANODHAS AI",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./provider": "./package/provider.mjs",
    "./chrome-provider": "./package/chrome-provider.mjs",
    "./chrome-chain": "./package/chrome-chain.mjs",
    "./client": "./package/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./computer": "./computer/index.mjs",
    "./shared-browser": "./shared-browser/index.cjs",
    "./opencode-plugin": "./shared-browser/opencode-plugin/index.mjs",
    "./shared-provider": "./shared-browser/harness-plugin/index.mjs"
  },
  "files": [
    "index.mjs",
    "package",
    "chrome",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "VALIDATION.md",
    "docs",
    "computer",
    "Install.command",
    "pnpm-lock.yaml",
    "shared-browser"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-browser-use": "0.2.2-rc.1",
    "@deepseek-ai/dsh-experimental-browser-use-runtime": "0.2.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@playwright/mcp": "0.0.80",
    "playwright": "1.63.0-alpha-2026-08-31",
    "yaml": "2.8.1"
  },
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "check": "node scripts/check-package.cjs",
    "setup:chrome": "node scripts/setup-chrome.cjs",
    "install:browser": "node scripts/install-browser.cjs",
    "test:computer": "node --test test/computer-test.cjs test/installer-test.cjs test/computer-direct-test.cjs",
    "test:learning": "node test/test-memory.cjs && node test/test-refresh.cjs && node test/test-router.cjs && node test/test-private.mjs",
    "build:installer": "node scripts/build-installer.cjs",
    "test:shared": "node --test test/shared-browser-test.cjs test/shared-browser-plugin-test.cjs test/shared-browser-real-test.cjs test/shared-browser-shared-test.cjs",
    "build:native": "node scripts/build-native.cjs"
  },
  "devDependencies": {}
}
